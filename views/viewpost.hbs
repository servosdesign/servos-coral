{{> header }}
<div class="viewPosts">
    <h1 class="title">{{currentPost.title}}</h1>
    <img class="resize" src="/{{currentPost.image}}" alt="">
    <div class="mainPostsContent">
        <p class="post-description">{{currentPost.description}}</p>
        <p class="author">{{currentPost.username}}</p>
        <p class="date-posted">{{formateDate currentPost.createdAt}}</p>
        <div class="commentBox">
            <textarea id="comment-text" cols="52" rows="1"></textarea>
            <button class="homeBtns" id="commentButton" data-postid="{{currentPost.id}}">Comment</button>
        </div>
    </div>
</div>
<div class="viewPosts" id="comment-list">
    {{#each currentPost.comments}}
    <div class="comment-box" id="{{this.id}}">
        <p class="author">{{this.username}}</p>
        <p class="post-description">{{this.text}}</p>
        <p class="date-posted">{{formateDateShort this.createdAt}}</p>
    </div>
    {{/each}}
</div>

<script>
    function addNewComment(data) {
        let commentList = document.getElementById('comment-list');
        let newComent = document.createElement('template');
        newComent.innerHTML = `<div class="comment-box" id="message-${data.commentId}">
        <p class="author">${data.username}</p>
        <p class="post-description">${data.comment}</p>
        <p class="date-posted">${new Date().toLocaleString(data.createdAt)}</p>
    </div>`;
        commentList.append(newComent.content);
        document.getElementById(`message-${data.commentId}`).scrollIntoView();
    }

    document.getElementById('commentButton').addEventListener('click', function (ev) {
        let commentTextElement = document.getElementById('comment-text');
        let commentText = commentTextElement.value;
        let postId = ev.currentTarget.dataset.postid;

        if (!commentText) return;

        fetch("/comments/create", {
            method: "POST",
            headers: {
                "Content-Type": "Application/json"
            },
            body: JSON.stringify({
                comment: commentText,
                postId: postId
            })
        }).then(response => response.json())
            .then(res_json => {
                addNewComment(res_json.data);
            }).catch(err => console.log(err));
    });
</script>