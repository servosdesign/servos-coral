{{> header }}
<div id="wrapper">
  <div class="main-content">
    <div class="header">
      <img src="/public/assets/logo.PNG" />
    </div>
    <form class="loginInput" action="/users/login" method="POST" enctype="application/x-www-form-urlencoded">
      <input id="username" type="text" placeholder="Username" name="username" class="formInput" required />
      <input id="password" type="password" placeholder="Password" name="password" class="formInput" required />
      <button type="submit" class="btn">Log in</button>
    </form>
  </div>
  <div class="signup">
    Don't have an account?
    <a href="registration"><button class="btn">Sign up</button></a>
  </div>
</div>
</div>