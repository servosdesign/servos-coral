{{> header }}
</div>
<div>
    <h1 class="titleHeader"></h1>
    <h2 clas="titleHeader" id="counter"></h2>
</div>
<div id="imageContent">
    {{#each results}}
        <div>
            <img src="{{this.thumbnail}}" alt="">
            <p>{{this.title}}</p>
            <p>{{this.description}}</p>
            <a href="/posts/{{this.id}}">Details</a>
        </div>
    {{/each}}
</div>

