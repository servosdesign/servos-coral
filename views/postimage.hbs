{{> header }}
<div class="post">
    <h1> Post Image</h1>
    <div class="main-content">
        <form action="">
            <input type="text" placeholder="Post Title" class="postTitle" required />
            <input type="text" placeholder="Post Description" class="postDescription" required />
            <input type="file" id="myFile" class="fileName" required>
            <label for="User Agreement" class="user">User Agreement</label>
            <input type="checkbox" placeholder="Accept Use Policy" class="userPolicy" required />
            <button type="submit" class="btn">Post</button>
        </form>
    </div>
</div>