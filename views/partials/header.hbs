{{#if isLoggedIn}}
  <script>
    document.getElementById('logout-btn').addEventListener('click', function(ev) {
      fetch('/users/logout', {method: "POST"})
        .then(response => response.json())
        .then(function(res_json){
          console.log(res_json);
          window.location.replace('/');
        }).catch (err => {
          console.log(err);
        })
    });
  </script>
{{/if}}